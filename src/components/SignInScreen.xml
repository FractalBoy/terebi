<?xml version="1.0" encoding="utf-8"?>
<component name="SignInScreen" extends="Group">
  <interface>
    <field id="setup" type="boolean" />
    <field id="serverUrl" type="string" />
    <field id="username" type="string" />
    <field id="password" type="string" />
  </interface>

  <children>
    <Label id="SignInTitle" height="50" width="600" text="Sign in to your account"
      translation="[120,205]" font="font:LargeBoldSystemFont" />
    <TextEditBox id="SigninURL" height="50" width="600" translation="[100,240]"
      clearOnDownKey="false" hintText="Enter Dispatcharr URL" />
    <TextEditBox id="SigninUsername" height="50" width="600" translation="[100,295]"
      clearOnDownKey="false" hintText="Enter username" />
    <TextEditBox id="SigninPassword" height="50" width="600" translation="[100,345]"
      clearOnDownKey="false" secureMode="true" hintText="Enter user password" />
    <Button id="signInButton" text="Sign In" visible="true" showFocusFootprint="true" minWidth="140"
      height="72" iconUri="" focusedIconUri="" translation="[100,410]" />
    <StandardKeyboardDialog id="signinKeyboard" width="1020" height="565" visible="false" />
  </children>
</component>