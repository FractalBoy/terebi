sub init()
    m.poster = m.top.findNode("poster")
    m.focusBorder = m.top.findNode("focusBorder")
    m.statusBackground = m.top.findNode("statusBackground")
    m.statusIcon = m.top.findNode("statusIcon")
    m.statusText = m.top.findNode("statusText")
    m.title = m.top.findNode("title")
    m.subtitle = m.top.findNode("subtitle")
end sub

sub showContent()
    if m.top.itemContent = invalid
        return
    end if

    m.poster.uri = m.top.itemContent.posterUrl
    m.title.text = m.top.itemContent.title
    m.subtitle.text = m.top.itemContent.secondaryTitle
    status = m.top.itemContent.recordingStatus
    if status = "recording"
        m.statusIcon.text = "●"
        m.statusText.text = "LIVE"
        m.statusIcon.color = "0xff5a5aff"
        m.statusBackground.color = "0x132238ee"
        m.statusBackground.width = 140
        m.statusText.width = 96
    else if status = "completed"
        m.statusIcon.text = "✓"
        m.statusText.text = "RECORDED"
        m.statusIcon.color = "0x7dd3fcff"
        m.statusBackground.color = "0x132238ee"
        m.statusBackground.width = 300
        m.statusText.width = 252
    else
        m.statusIcon.text = "•"
        m.statusText.text = "UNKNOWN"
        m.statusIcon.color = "0xa9bad2ff"
        m.statusBackground.color = "0x475569ee"
        m.statusBackground.width = 160
        m.statusText.width = 116
    end if
end sub

sub showFocus()
    m.focusBorder.visible = m.top.itemHasFocus
    if m.top.itemHasFocus
        m.top.scale = [1.04, 1.04]
    else
        m.top.scale = [1.0, 1.0]
    end if
end sub
