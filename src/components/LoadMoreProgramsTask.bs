sub init()
    m.top.functionName = "getPrograms"
end sub

sub getPrograms()
    startTime = CreateObject("roDateTime")
    startTime.FromSeconds(m.top.startTime)
    endTime = CreateObject("roDateTime")
    endTime.FromSeconds(startTime.AsSeconds() + 3600 * 5)

    programs = getAllPages(m.top.serverUrl + "/api/epg/grid/?start=" + startTime.ToISOString() + "&end=" + endTime.ToISOString())
    if programs = invalid then return

    programsByTvgId = {}
    for each program in programs
        if program.tvg_id <> invalid
            key = program.tvg_id.toStr()
            if programsByTvgId[key] = invalid then programsByTvgId[key] = []
            programsByTvgId[key].push(program)
        end if
    end for

    m.top.endTime = endTime.AsSeconds()
    m.top.programs = programsByTvgId
end sub


function getAllPages(url as string) as object
    allItems = []
    nextUrl = url
    while nextUrl <> ""
        response = getJson(nextUrl)
        if response = invalid then return invalid
        if type(response) = "roArray"
            for each item in response
                allItems.push(item)
            end for
            nextUrl = ""
        else if response.results <> invalid and type(response.results) = "roArray"
            for each item in response.results
                allItems.push(item)
            end for
            if response.next <> invalid then nextUrl = response.next else nextUrl = ""
        else if response.data <> invalid and type(response.data) = "roArray"
            for each item in response.data
                allItems.push(item)
            end for
            if response.next <> invalid then nextUrl = response.next else nextUrl = ""
        else
            return invalid
        end if
        if nextUrl <> "" and left(nextUrl, 4) <> "http" then nextUrl = m.top.serverUrl + nextUrl
    end while
    return allItems
end function

function getJson(url as string) as dynamic
    xfer = CreateObject("roUrlTransfer")
    xfer.setUrl(url)
    xfer.SetCertificatesFile("common:/certs/ca-bundle.crt")
    xfer.AddHeader("X-Roku-Reserved-Dev-Id", "")
    xfer.InitClientCertificates()
    xfer.addHeader("Authorization", "Bearer " + m.top.accessToken)
    xfer.addHeader("Accept", "application/json")
    port = CreateObject("roMessagePort")
    xfer.SetMessagePort(port)
    if not xfer.AsyncGetToString()
        return invalid
    end if
    msg = wait(0, port)
    if type(msg) <> "roUrlEvent"
        return invalid
    end if
    if msg.GetResponseCode() < 200 or msg.GetResponseCode() >= 300
        return invalid
    end if
    return ParseJson(msg.GetString())
end function
