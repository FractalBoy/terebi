sub init()
    m.top.functionName = "getJwtToken"
end sub

sub getJwtToken()
    m.top.accessToken = ""
    m.top.refreshToken = ""
    m.top.failureMessage = ""
    m.top.authStatus = "running"

    xfer = CreateObject("roUrlTransfer")
    xfer.setUrl(m.top.serverUrl + "/api/accounts/token/")
    xfer.SetCertificatesFile("common:/certs/ca-bundle.crt")
    xfer.AddHeader("X-Roku-Reserved-Dev-Id", "")
    xfer.InitClientCertificates()
    xfer.AddHeader("Content-Type", "application/json")
    xfer.AddHeader("Accept", "application/json")

    body = { username: m.top.username, password: m.top.password }
    port = CreateObject("roMessagePort")
    xfer.SetMessagePort(port)

    if not xfer.AsyncPostFromString(FormatJson(body))
        failAuthentication("Unable to start the sign-in request.")
        return
    end if

    msg = wait(0, port)
    if type(msg) <> "roUrlEvent"
        failAuthentication("No response was received from the server.")
        return
    end if

    responseCode = msg.GetResponseCode()
    if responseCode < 200 or responseCode >= 300
        failAuthentication("The server rejected the sign-in request.")
        return
    end if

    response = ParseJson(msg.GetString())
    if response = invalid
        failAuthentication("The server did not return authentication tokens.")
        return
    end if

    if response.access = invalid or response.access = ""
        failAuthentication("The server did not return an access token.")
        return
    end if

    if response.refresh = invalid or response.refresh = ""
        failAuthentication("The server did not return a refresh token.")
        return
    end if

    m.top.accessToken = response.access
    m.top.refreshToken = response.refresh
    m.top.authStatus = "success"
end sub

sub failAuthentication(message as string)
    m.top.failureMessage = message
    m.top.authStatus = "failure"
end sub
