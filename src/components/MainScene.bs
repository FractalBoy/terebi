sub init()
    m.accessToken = ""
    m.refreshToken = ""
    m.authRequestId = 0
    m.refreshRequestId = 0
    m.isLoggedIn = false
    m.recordings = []
    m.requestMode = ""
    m.grid = m.top.findNode("recordingsGrid")
    m.topRail = m.top.findNode("topRail")
    m.libraryTitle = m.top.findNode("libraryTitle")
    m.libraryHint = m.top.findNode("libraryHint")
    m.recordingCount = m.top.findNode("recordingCount")
    m.detailsPanel = m.top.findNode("detailsPanel")
    m.detailsStatus = m.top.findNode("detailsStatus")
    m.detailsTitle = m.top.findNode("detailsTitle")
    m.detailsSubtitle = m.top.findNode("detailsSubtitle")
    m.detailsTime = m.top.findNode("detailsTime")
    m.detailsDescription = m.top.findNode("detailsDescription")
    m.loadingState = m.top.findNode("loadingState")
    m.emptyState = m.top.findNode("emptyState")
    m.errorState = m.top.findNode("errorState")
    m.libraryError = m.top.findNode("libraryError")
    m.retryButton = m.top.findNode("retryButton")
    m.errorLogoutButton = m.top.findNode("errorLogoutButton")
    m.dvrButton = m.top.findNode("dvrButton")
    m.refreshButton = m.top.findNode("refreshButton")
    m.logoutButton = m.top.findNode("logoutButton")
    m.video = m.top.findNode("video")
    m.signInScreen = m.top.findNode("signInScreen")
    m.getRecordingsTask = createObject("roSGNode", "GetRecordingsTask")
    m.refreshTimer = createObject("roSGNode", "Timer")
    m.refreshTimer.duration = 1500
    m.refreshTimer.repeat = false
    m.videoHttpAgent = CreateObject("roHttpAgent")
    m.video.setHttpAgent(m.videoHttpAgent)

    m.grid.observeField("itemSelected", "onRecordingSelected")
    m.grid.observeField("itemFocused", "onRecordingFocused")
    m.dvrButton.observeField("buttonSelected", "showDvr")
    m.refreshButton.observeField("buttonSelected", "requestRecordings")
    m.logoutButton.observeField("buttonSelected", "showLogoutConfirmation")
    m.retryButton.observeField("buttonSelected", "requestRecordings")
    m.errorLogoutButton.observeField("buttonSelected", "showLogoutConfirmation")
    m.signInScreen.observeField("submissionId", "onCredentialsSubmitted")
    m.getRecordingsTask.observeField("requestStatus", "onRecordingsRequestStatus")
    m.refreshTimer.observeField("fire", "onRefreshTimerFired")

    registry = CreateObject("roRegistrySection", "Terebi")
    if registry.exists("serverUrl") then m.top.serverUrl = registry.read("serverUrl")
    if registry.exists("username") then m.top.username = registry.read("username")
    if registry.exists("password") then m.top.password = registry.read("password")
    if hasCredentials()
        startAuthentication(false)
    else
        showSignInScreen("")
    end if
end sub

function hasCredentials() as boolean
    return m.top.serverUrl <> invalid and m.top.serverUrl <> "" and m.top.username <> invalid and m.top.username <> "" and m.top.password <> invalid and m.top.password <> ""
end function

sub showSignInScreen(errorMessage as string)
    m.isLoggedIn = false
    hideLibrary()
    m.signInScreen.serverUrl = m.top.serverUrl
    m.signInScreen.username = m.top.username
    m.signInScreen.password = m.top.password
    m.signInScreen.errorMessage = errorMessage
    m.signInScreen.visible = true
    m.signInScreen.activationId = m.signInScreen.activationId + 1
end sub

sub onCredentialsSubmitted()
    m.top.serverUrl = m.signInScreen.serverUrl
    m.top.username = m.signInScreen.username
    m.top.password = m.signInScreen.password
    startAuthentication(true)
end sub

sub startAuthentication(saveOnSuccess as boolean, isRecovery = false as boolean)
    m.authRequestId = m.authRequestId + 1
    m.saveCredentialsOnSuccess = saveOnSuccess
    m.isAuthenticationRecovery = isRecovery
    if not isRecovery then m.signInScreen.isSubmitting = true
    m.activeJwtTask = createObject("roSGNode", "GetJwtTokenTask")
    m.activeJwtTask.serverUrl = m.top.serverUrl
    m.activeJwtTask.username = m.top.username
    m.activeJwtTask.password = m.top.password
    m.activeJwtTask.requestId = m.authRequestId
    m.activeJwtTask.observeFieldScoped("authStatus", "onJwtAuthenticationChanged")
    m.activeJwtTask.control = "run"
end sub

sub onJwtAuthenticationChanged()
    if m.activeJwtTask = invalid or m.activeJwtTask.requestId <> m.authRequestId
        return
    end if
    if m.activeJwtTask.authStatus = "success"
        m.accessToken = m.activeJwtTask.accessToken
        m.refreshToken = m.activeJwtTask.refreshToken
        updateVideoAuthorization()
        scheduleTokenRefresh()
        if m.saveCredentialsOnSuccess
            registry = CreateObject("roRegistrySection", "Terebi")
            registry.write("serverUrl", m.top.serverUrl)
            registry.write("username", m.top.username)
            registry.write("password", m.top.password)
            registry.flush()
        end if
        m.isLoggedIn = true
        m.signInScreen.visible = false
        m.signInScreen.isSubmitting = false
        if not m.isAuthenticationRecovery
            requestRecordings()
        end if
    else if m.activeJwtTask.authStatus = "failure"
        clearTokens()
        showSignInScreen(m.activeJwtTask.failureMessage)
    end if
end sub

sub scheduleTokenRefresh()
    m.refreshTimer.control = "stop"
    m.refreshTimer.control = "start"
end sub

sub onRefreshTimerFired()
    if not m.isLoggedIn then return
    startAccessTokenRefresh()
end sub

sub startAccessTokenRefresh()
    if m.refreshToken = invalid or m.refreshToken = "" then return
    m.refreshRequestId = m.refreshRequestId + 1
    m.activeRefreshTask = createObject("roSGNode", "RefreshAccessTokenTask")
    m.activeRefreshTask.serverUrl = m.top.serverUrl
    m.activeRefreshTask.refreshToken = m.refreshToken
    m.activeRefreshTask.requestId = m.refreshRequestId
    m.activeRefreshTask.observeField("refreshStatus", "onAccessTokenRefreshChanged")
    m.activeRefreshTask.control = "run"
end sub

sub onAccessTokenRefreshChanged()
    if m.activeRefreshTask = invalid or m.activeRefreshTask.requestId <> m.refreshRequestId
        return
    end if
    if m.activeRefreshTask.refreshStatus = "success"
        m.accessToken = m.activeRefreshTask.accessToken
        updateVideoAuthorization()
        scheduleTokenRefresh()
    else if m.activeRefreshTask.refreshStatus = "failure"
        startAuthentication(false, true)
    end if
end sub

sub updateVideoAuthorization()
    if m.accessToken = invalid or m.accessToken = ""
        m.videoHttpAgent.setHeaders({})
    else
        m.videoHttpAgent.setHeaders({ Authorization: "Bearer " + m.accessToken })
    end if
end sub

sub clearTokens()
    m.accessToken = ""
    m.refreshToken = ""
    updateVideoAuthorization()
end sub

sub requestRecordings()
    if not m.isLoggedIn then return
    m.requestMode = "library"
    hideLibrary()
    m.loadingState.visible = true
    m.getRecordingsTask.serverUrl = m.top.serverUrl
    m.getRecordingsTask.accessToken = m.accessToken
    m.getRecordingsTask.recordingId = ""
    m.getRecordingsTask.observeField("recordings", "onRecordingsReturned")
    m.getRecordingsTask.control = "run"
end sub

sub onRecordingsRequestStatus()
    if m.getRecordingsTask.requestStatus <> "failure" then return
    if m.requestMode = "library"
        m.getRecordingsTask.unobserveField("recordings")
        m.loadingState.visible = false
        m.errorState.visible = true
        m.topRail.visible = true
        m.libraryError.text = m.getRecordingsTask.failureMessage
        m.retryButton.setFocus(true)
    else if m.requestMode = "playback"
        showPlaybackError(m.getRecordingsTask.failureMessage)
    end if
end sub

sub onRecordingsReturned()
    m.getRecordingsTask.unobserveField("recordings")
    if not m.isLoggedIn then return
    if m.requestMode = "playback"
        playRecording()
        return
    end if
    m.recordings = m.getRecordingsTask.recordings
    m.loadingState.visible = false
    m.topRail.visible = true
    if m.recordings.count() = 0
        m.emptyState.visible = true
        return
    end if
    content = CreateObject("roSGNode", "ContentNode")
    for each recording in m.recordings
        item = content.createChild("ContentNode")
        item.addFields({ posterUrl: "", recordingStatus: "", programStart: "", programEnd: "", remuxSuccess: false })
        item.title = recording.custom_properties.program.title
        item.secondaryTitle = recording.custom_properties.program.sub_title
        item.description = recording.custom_properties.program.description
        item.posterUrl = recording.custom_properties.poster_url
        item.recordingStatus = recording.custom_properties.status
        item.remuxSuccess = recording.custom_properties.remux_success
        item.programStart = recording.start_time
        item.programEnd = recording.end_time
    end for
    m.recordingCount.text = m.recordings.count().toStr() + " recordings"
    m.grid.content = content
    m.grid.visible = true
    m.libraryTitle.visible = true
    m.libraryHint.visible = true
    m.grid.setFocus(true)
    showRecordingDetails(0)
end sub

sub onRecordingFocused()
    if m.grid.visible then showRecordingDetails(m.grid.itemFocused)
end sub

sub showRecordingDetails(index as integer)
    if index < 0 or index >= m.recordings.count()
        m.detailsPanel.visible = false
        return
    end if
    program = m.recordings[index].custom_properties.program
    status = m.recordings[index].custom_properties.status
    if status = "recording"
        m.detailsStatus.text = "●  IN PROGRESS"
    else if status = "completed" or status = "stopped"
        m.detailsStatus.text = "✓  RECORDED"
    else
        m.detailsStatus.text = "•  STATUS UNKNOWN"
    end if
    m.detailsTitle.text = program.title
    m.detailsSubtitle.text = program.sub_title
    m.detailsTime.text = displayDateTime(m.recordings[index].start_time) + "  —  " + displayDateTime(m.recordings[index].end_time)
    m.detailsDescription.text = program.description
    m.detailsPanel.visible = true
end sub

function displayDateTime(value as string) as string
    if value = invalid or len(value) < 16 then return "Time unavailable"

    dateTime = CreateObject("roDateTime")
    dateTime.FromISO8601String(value)
    dateTime.ToLocalTime()
    return dateTime.GetYear().toStr() + "-" + padDateTimeValue(dateTime.GetMonth()) + "-" + padDateTimeValue(dateTime.GetDayOfMonth()) + "  " + padDateTimeValue(dateTime.GetHours()) + ":" + padDateTimeValue(dateTime.GetMinutes())
end function

function padDateTimeValue(value as integer) as string
    if value < 10 then return "0" + value.toStr()
    return value.toStr()
end function

sub hideLibrary()
    m.grid.visible = false
    m.topRail.visible = false
    m.libraryTitle.visible = false
    m.libraryHint.visible = false
    m.detailsPanel.visible = false
    m.loadingState.visible = false
    m.emptyState.visible = false
    m.errorState.visible = false
end sub

sub showDvr()
    if m.grid.visible then m.grid.setFocus(true)
end sub

sub onRecordingSelected()
    index = m.grid.itemSelected
    if index < 0 or index >= m.recordings.count() then return
    m.requestMode = "playback"
    m.getRecordingsTask.recordingId = m.recordings[index].id.toStr()
    m.getRecordingsTask.accessToken = m.accessToken
    m.getRecordingsTask.observeField("recordings", "playRecording")
    m.getRecordingsTask.control = "run"
end sub

sub playRecording()
    m.getRecordingsTask.unobserveField("recordings")
    if not m.isLoggedIn or m.getRecordingsTask.recordings.count() = 0
        showPlaybackError("The selected recording is no longer available.")
        return
    end if
    recording = m.getRecordingsTask.recordings[0]
    mediaUrl = m.top.serverUrl + recording.custom_properties.file_url
    content = CreateObject("roSGNode", "ContentNode")
    content.url = mediaUrl
    content.title = recording.custom_properties.program.title
    if recording.custom_properties.status = "recording" or not recording.custom_properties.remux_success
        content.streamFormat = "hls"
        content.live = true
    else
        content.streamFormat = "mkv"
        if recording.custom_properties.program.endMs <> invalid and recording.custom_properties.program.startMs <> invalid
            content.length = (recording.custom_properties.program.endMs - recording.custom_properties.program.startMs) / 1000
        end if
    end if

    m.video.content = content
    hideLibrary()
    m.video.visible = true
    m.video.setFocus(true)
    m.video.control = "play"
end sub

sub showPlaybackError(message as string)
    m.playbackErrorDialog = createObject("roSGNode", "StandardMessageDialog")
    m.playbackErrorDialog.title = "Playback unavailable"
    m.playbackErrorDialog.message = [message]
    m.playbackErrorDialog.buttons = ["Back to library"]
    m.playbackErrorDialog.observeFieldScoped("buttonSelected", "closePlaybackError")
    m.top.dialog = m.playbackErrorDialog
end sub

sub closePlaybackError()
    m.playbackErrorDialog.close = true
    m.top.dialog = invalid
    requestRecordings()
end sub

sub showLogoutConfirmation()
    m.logoutConfirmed = false
    m.logoutDialog = createObject("roSGNode", "StandardMessageDialog")
    m.logoutDialog.title = "Log out?"
    m.logoutDialog.message = ["Saved server and sign-in credentials will be removed from this Roku."]
    m.logoutDialog.buttons = ["Log out", "Cancel"]
    m.logoutDialog.observeFieldScoped("buttonSelected", "onLogoutDialogSelected")
    m.logoutDialog.observeFieldScoped("wasClosed", "onLogoutDialogClosed")
    m.top.dialog = m.logoutDialog
end sub

sub onLogoutDialogSelected()
    if m.logoutDialog.buttonSelected = 0
        m.logoutConfirmed = true
        logout()
    end if
    m.logoutDialog.close = true
end sub

sub onLogoutDialogClosed()
    m.top.dialog = invalid
    if not m.logoutConfirmed and m.topRail.visible then m.logoutButton.setFocus(true)
end sub

sub logout()
    m.authRequestId = m.authRequestId + 1
    m.refreshRequestId = m.refreshRequestId + 1
    m.refreshTimer.control = "stop"
    clearTokens()
    m.activeJwtTask = invalid
    m.activeRefreshTask = invalid
    m.getRecordingsTask.control = "stop"
    m.top.serverUrl = ""
    m.top.username = ""
    m.top.password = ""
    registry = CreateObject("roRegistrySection", "Terebi")
    registry.delete("serverUrl")
    registry.delete("username")
    registry.delete("password")
    registry.flush()
    if m.video.visible
        m.video.control = "stop"
        m.video.visible = false
    end if
    showSignInScreen("")
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.video.visible
        if key = "back"
            m.video.control = "stop"
            m.video.visible = false
            m.grid.visible = true
            m.topRail.visible = true
            m.libraryTitle.visible = true
            m.libraryHint.visible = true
            showRecordingDetails(m.grid.itemFocused)
            m.grid.setFocus(true)
            return true
        end if
        return false
    end if
    if key = "up" and m.grid.hasFocus()
        m.dvrButton.setFocus(true)
        return true
    end if
    if m.dvrButton.hasFocus()
        if key = "right"
            m.refreshButton.setFocus(true)
            return true
        else if key = "down"
            m.grid.setFocus(true)
            return true
        end if
    end if
    if m.refreshButton.hasFocus()
        if key = "left"
            m.dvrButton.setFocus(true)
            return true
        else if key = "right"
            m.logoutButton.setFocus(true)
            return true
        else if key = "down"
            m.grid.setFocus(true)
            return true
        end if
    end if
    if m.logoutButton.hasFocus()
        if key = "left"
            m.refreshButton.setFocus(true)
            return true
        else if key = "down"
            m.grid.setFocus(true)
            return true
        end if
    end if
    return false
end function
