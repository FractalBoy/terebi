<?xml version="1.0" encoding="utf-8"?>
<component name="GetJwtTokenTask" extends="Task">
    <interface>
        <field id="serverUrl" type="string" />
        <field id="username" type="string" />
        <field id="password" type="string" />
        <field id="requestId" type="integer" />
        <field id="accessToken" type="string" />
        <field id="refreshToken" type="string" />
        <field id="authStatus" type="string" value="idle" />
        <field id="failureMessage" type="string" />
    </interface>
</component>
