sub init()
    m.serverUrlField = m.top.findNode("signinURL")
    m.usernameField = m.top.findNode("signinUsername")
    m.passwordField = m.top.findNode("signinPassword")
    m.signInButton = m.top.findNode("signInButton")
    m.errorLabel = m.top.findNode("signInError")
    m.fieldFocusBorder = m.top.findNode("fieldFocusBorder")

    m.top.observeField("activationId", "onActivated")
    m.top.observeField("errorMessage", "onErrorMessageChanged")
    m.signInButton.observeField("buttonSelected", "submitCredentials")
    m.selectedField = "serverUrl"
end sub

sub onActivated()
    m.serverUrlField.text = m.top.serverUrl
    m.usernameField.text = m.top.username
    m.passwordField.text = m.top.password
    m.errorLabel.text = m.top.errorMessage
    m.top.isSubmitting = false

    if m.serverUrlField.text = ""
        m.selectedField = "serverUrl"
    else if m.usernameField.text = ""
        m.selectedField = "username"
    else if m.passwordField.text = ""
        m.selectedField = "password"
    else
        m.selectedField = "serverUrl"
    end if

    focusSelectedField()
end sub

sub onErrorMessageChanged()
    m.errorLabel.text = m.top.errorMessage
end sub

sub focusSelectedField()
    if m.selectedField = "serverUrl"
        m.fieldFocusBorder.visible = true
        m.fieldFocusBorder.translation = [492,332]
        m.serverUrlField.setFocus(true)
    else if m.selectedField = "username"
        m.fieldFocusBorder.visible = true
        m.fieldFocusBorder.translation = [492,477]
        m.usernameField.setFocus(true)
    else if m.selectedField = "password"
        m.fieldFocusBorder.visible = true
        m.fieldFocusBorder.translation = [492,622]
        m.passwordField.setFocus(true)
    else
        m.fieldFocusBorder.visible = false
        m.signInButton.setFocus(true)
    end if
end sub

sub showKeyboard()
    m.keyboardDialog = createObject("roSGNode", "StandardKeyboardDialog")
    m.keyboardDialog.width = 0
    m.keyboardDialog.height = 0
    m.keyboardDialog.buttons = ["Done"]
    m.keyboardDialog.observeFieldScoped("buttonSelected", "onKeyboardDone")
    m.keyboardDialog.observeFieldScoped("wasClosed", "onKeyboardClosed")

    if m.selectedField = "serverUrl"
        m.keyboardDialog.title = "Dispatcharr server URL"
        m.keyboardDialog.keyboardDomain = "generic"
        m.keyboardDialog.text = m.serverUrlField.text
        m.keyboardDialog.textEditBox.secureMode = false
    else if m.selectedField = "username"
        m.keyboardDialog.title = "Username"
        m.keyboardDialog.keyboardDomain = "alphanumeric"
        m.keyboardDialog.text = m.usernameField.text
        m.keyboardDialog.textEditBox.secureMode = false
    else
        m.keyboardDialog.title = "Password"
        m.keyboardDialog.keyboardDomain = "password"
        m.keyboardDialog.text = m.passwordField.text
        m.keyboardDialog.textEditBox.secureMode = true
        m.keyboardDialog.textEditBox.secureLastCharacter = true
    end if

    scene = m.top.getScene()
    scene.dialog = m.keyboardDialog
    m.keyboardDialog.setFocus(true)
end sub

sub onKeyboardDone()
    if m.selectedField = "serverUrl"
        m.serverUrlField.text = m.keyboardDialog.text
    else if m.selectedField = "username"
        m.usernameField.text = m.keyboardDialog.text
    else
        m.passwordField.text = m.keyboardDialog.text
    end if

    m.keyboardDialog.close = true
end sub

sub onKeyboardClosed()
    scene = m.top.getScene()
    scene.dialog = invalid
    focusSelectedField()
end sub

sub submitCredentials()
    if m.serverUrlField.text = "" or m.usernameField.text = "" or m.passwordField.text = ""
        m.top.errorMessage = "Enter a server URL, username, and password."
        return
    end if

    m.top.serverUrl = m.serverUrlField.text
    m.top.username = m.usernameField.text
    m.top.password = m.passwordField.text
    m.top.errorMessage = ""
    m.top.isSubmitting = true
    m.top.submissionId = m.top.submissionId + 1
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.top.isSubmitting
        return m.top.isSubmitting
    end if

    if key = "down"
        if m.selectedField = "serverUrl"
            m.selectedField = "username"
        else if m.selectedField = "username"
            m.selectedField = "password"
        else if m.selectedField = "password"
            m.selectedField = "button"
        end if
        focusSelectedField()
        return true
    else if key = "up"
        if m.selectedField = "button"
            m.selectedField = "password"
        else if m.selectedField = "password"
            m.selectedField = "username"
        else if m.selectedField = "username"
            m.selectedField = "serverUrl"
        end if
        focusSelectedField()
        return true
    else if key = "OK" and m.selectedField <> "button"
        showKeyboard()
        return true
    end if

    return false
end function
