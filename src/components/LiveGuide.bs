sub init()
    m.timeGrid = m.top.findNode("timeGrid")
    m.timeGrid.observeField("channelFocused", "onChannelFocused")
    m.timeGrid.observeField("programSelected", "onProgramSelected")
end sub

sub showGuide()
    if m.top.guideChannels = invalid then return
    now = CreateObject("roDateTime")
    m.timeGrid.contentStartTime = now.asSeconds()
    buildContent()
    if m.top.guideChannels.count() > 0
        m.timeGrid.setFocus(true)
        m.top.channelSelected = 0
    end if
end sub

sub buildContent()
    content = CreateObject("roSGNode", "ContentNode")
    for each channel in m.top.guideChannels
        channelNode = content.createChild("ContentNode")
        channelNode.title = channel.channelNumber.toStr() + "  " + channel.name
        channelNode.hdSmallIconUrl = channel.logoUrl
        addPrograms(channelNode, channel.programs)
    end for
    m.timeGrid.content = content
end sub

sub onChannelFocused()
    if m.timeGrid.channelFocused >= 0 then m.top.channelSelected = m.timeGrid.channelFocused
end sub

sub onProgramSelected()
    if m.timeGrid.channelFocused >= 0 then m.top.channelActivated = m.timeGrid.channelFocused
end sub

sub focusGuide()
    m.timeGrid.setFocus(true)
end sub

sub addPrograms(channelNode as object, programs as object)
    if programs = invalid then return
    previousEnd = 0
    for each program in programs
        startSeconds = isoToSeconds(program.start_time)
        endSeconds = isoToSeconds(program.end_time)
        isValid = startSeconds > 0 and endSeconds > startSeconds
        if isValid and startSeconds < previousEnd
            if endSeconds <= previousEnd
                isValid = false
            else
                startSeconds = previousEnd
            end if
        end if
        if isValid
            programNode = channelNode.createChild("ContentNode")
            programNode.title = program.title
            programNode.playStart = startSeconds
            programNode.playDuration = endSeconds - startSeconds
            previousEnd = endSeconds
        end if
    end for
end sub

function isoToSeconds(value as dynamic) as integer
    if value = invalid or value = "" then return 0
    dateTime = CreateObject("roDateTime")
    dateTime.fromISO8601String(value)
    return dateTime.asSeconds()
end function
