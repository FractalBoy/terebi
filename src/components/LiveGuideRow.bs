sub init()
    m.logo = m.top.findNode("logo")
    m.channelNumber = m.top.findNode("channelNumber")
    m.channelName = m.top.findNode("channelName")
    m.programs = m.top.findNode("programs")
    m.focusBorder = m.top.findNode("focusBorder")
end sub

sub showContent()
    if m.top.itemContent = invalid or m.top.itemContent.channelData = invalid then return
    channel = m.top.itemContent.channelData
    m.logo.uri = channel.logoUrl
    m.channelNumber.text = channel.channelNumber.toStr()
    m.channelName.text = channel.name
    if m.programs.getChildCount() > 0 then m.programs.removeChildrenIndex(0, m.programs.getChildCount())

    windowStart = m.top.itemContent.windowStart
    windowSeconds = m.top.itemContent.windowSeconds
    cursorTime = m.top.itemContent.cursorTime
    windowEnd = windowStart + windowSeconds
    displayedProgram = false
    for each program in channel.programs
        startSeconds = isoToSeconds(program.start_time)
        endSeconds = isoToSeconds(program.end_time)
        if startSeconds < windowEnd and endSeconds > windowStart
            leftEdge = startSeconds
            if leftEdge < windowStart then leftEdge = windowStart
            rightEdge = endSeconds
            if rightEdge > windowEnd then rightEdge = windowEnd
            x = int(((leftEdge - windowStart) * 1416) / windowSeconds)
            width = int(((rightEdge - leftEdge) * 1416) / windowSeconds)
            if width < 2 then width = 2
            addProgram(program, x, width, cursorTime >= startSeconds and cursorTime < endSeconds)
            displayedProgram = true
        end if
    end for
    if not displayedProgram then addUnavailableProgram()
end sub

sub addUnavailableProgram()
    unavailable = CreateObject("roSGNode", "Label")
    unavailable.translation = [18, 34]
    unavailable.width = 520
    unavailable.height = 32
    unavailable.font = "font:SmallSystemFont"
    unavailable.color = "0xa9bad2ff"
    unavailable.text = "No guide information"
    m.programs.appendChild(unavailable)
end sub

sub addProgram(program as object, x as integer, width as integer, isCurrent as boolean)
    block = CreateObject("roSGNode", "Group")
    block.translation = [x, 6]
    background = CreateObject("roSGNode", "Rectangle")
    background.width = width - 2
    background.height = 88
    if isCurrent
        background.color = "0x245b8fff"
    else
        background.color = "0x1b3554ff"
    end if
    title = CreateObject("roSGNode", "Label")
    title.translation = [10, 12]
    title.width = width - 20
    title.height = 30
    title.font = "font:SmallBoldSystemFont"
    title.color = "0xf4f8ffff"
    title.maxLines = 1
    title.text = program.title
    block.appendChild(background)
    block.appendChild(title)
    if program.sub_title <> invalid and program.sub_title <> ""
        subtitle = CreateObject("roSGNode", "Label")
        subtitle.translation = [10, 46]
        subtitle.width = width - 20
        subtitle.height = 26
        subtitle.font = "font:SmallSystemFont"
        subtitle.color = "0xa9bad2ff"
        subtitle.maxLines = 1
        subtitle.text = program.sub_title
        block.appendChild(subtitle)
    end if
    m.programs.appendChild(block)
end sub

function isoToSeconds(value as string) as integer
    dateTime = CreateObject("roDateTime")
    dateTime.fromISO8601String(value)
    return dateTime.asSeconds()
end function

sub showFocus()
    m.focusBorder.visible = m.top.itemHasFocus
end sub
