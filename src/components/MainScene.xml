<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="serverUrl" type="string" />
        <field id="username" type="string" />
        <field id="password" type="string" />
    </interface>
    <children>
        <Group id="topRail" visible="false">
            <Rectangle width="1920" height="112" color="0xff1b1b1b" />
            <Button id="logoutButton" text="Log out" translation="[24,20]" minWidth="180"
                height="64" showFocusFootprint="true" />
            <Button id="dvrButton" text="DVR" translation="[870,20]" minWidth="180"
                height="64" showFocusFootprint="true" />
        </Group>
        <LabelList id="recordingsList" translation="[70,150]" itemSize="[1100,65]" numRows="8"
            focusable="true" />
        <Video id="video" visible="false" />
        <SignInScreen id="signInScreen" visible="false" />
    </children>
</component>
