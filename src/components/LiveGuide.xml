<?xml version="1.0" encoding="utf-8"?>
<component name="LiveGuide" extends="Group">
    <interface>
        <field id="serverUrl" type="string" />
        <field id="accessToken" type="string" />
        <field id="guideChannels" type="roArray" onChange="showGuide" />
        <field id="channelSelected" type="integer" />
        <field id="channelActivated" type="integer" alwaysNotify="true" />
        <field id="endTime" type="integer" />
        <function name="focusGuide" />
    </interface>
    <children>
        <Label text="Live TV" translation="[74,100]" width="900" height="46"
            font="font:LargeBoldSystemFont" color="0xf4f8ffff" />
        <Label text="Browse channels and programs. Press OK to watch." translation="[76,150]"
            width="900" height="28" font="font:SmallSystemFont" color="0xa9bad2ff" />
        <TimeGrid id="timeGrid" translation="[0,300]" numRows="10"
            channelInfoComponentName="LiveGuideChannelInfo" />
    </children>
</component>