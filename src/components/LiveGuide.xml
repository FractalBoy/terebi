<?xml version="1.0" encoding="utf-8"?>
<component name="LiveGuide" extends="Group">
    <interface>
        <field id="serverUrl" type="string" />
        <field id="accessToken" type="string" />
        <field id="guideChannels" type="roArray" onChange="showGuide" />
        <field id="channelSelected" type="integer" />
        <field id="channelActivated" type="integer" alwaysNotify="true" />
        <field id="endTime" type="integer" />
        <function name="focusGuide" />
    </interface>
    <children>
        <Group translation="[50,0]">
            <Label id="programTitle" font="font:LargeBoldSystemFont" translation="[0,100]" />
            <Label id="programSubtitle" font="font:MediumSystemFont" translation="[0,157]" />
            <Label id="programDescription" font="font:SmallSystemFont" translation="[0,215]"
                width="1000" wrap="true" />
            <Poster id="programPoster" loadHeight="300" loadWidth="500" />
        </Group>
        <TimeGrid id="timeGrid" translation="[0,600]"
            channelInfoComponentName="LiveGuideChannelInfo" />
    </children>
</component>